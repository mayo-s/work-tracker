{
  "base": {
    "project_name": "work-tracker",
    "app_function": "src.lambda_app.app",
    "aws_region": "eu-central-1",
    "runtime": "python3.14",
    "architecture": "x86_64",
    "manage_roles": false,
    "apigateway_enabled": false,
    "function_url_enabled": true,
    "function_url_config": {"authorizer": "NONE", "cors": {}},
    "memory_size": 1769,
    "timeout_seconds": 60,
    "keep_warm": true,
    "log_level": "WARNING",
    "aws_environment_variables": {"TZ": "CET-1CEST,M3.5.0,M10.5.0/3", "INSTANTIATE_LAMBDA_HANDLER_ON_IMPORT": "1"},
    "exclude": ["*.db", ".env", ".env.example", ".git", ".idea", ".venv", "__pycache__", "*.pyc", "node_modules"],
    "exclude_glob": [
      "examples", "docs", "deploy", "src/tests", "src/templates/tests", "Dockerfile", "compose.yaml", "package.json",
      "package-lock.json"
    ],
    "callbacks": {"zip": "deploy.bytecode.add_to_package"}
  },
  "dev": {
    "extends": "base",
    "s3_bucket": "work-tracker-deploy-dev",
    "aws_environment_variables": {
      "TZ": "CET-1CEST,M3.5.0,M10.5.0/3", "INSTANTIATE_LAMBDA_HANDLER_ON_IMPORT": "1", "WORK_TRACKER_TIMING": "on"
    }
  },
  "prod": {
    "extends": "base",
    "s3_bucket": "work-tracker-deploy-prod"
  }
}
